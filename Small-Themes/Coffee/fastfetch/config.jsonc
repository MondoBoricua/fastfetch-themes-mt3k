//  https://github.com/MondoBoricua/fastfetch-themes-mt3k
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "$HOME/.config/fastfetch/ascii.txt",
        "padding": {
            "top": 2,
            "right": 6
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
	"break",
	"break",
        {
            "type": "os",
            "key": "OS  ",
            "keyColor": "33",
        },
        {
            "type": "kernel",
            "key": "KER ",
            "keyColor": "33",
        },
        {
            "type": "packages",
            "key": "PKG ",
            "keyColor": "33",
        },
        {
            "type": "shell",
            "key": "SH  ",
            "keyColor": "33",
        },
        {
            "type": "wm",
            "key": "WM  ",
            "keyColor": "33",
        },

        "break",
        "break",
    ]
}
