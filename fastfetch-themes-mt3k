                    echo -e "${WHITE}  Images:   ${ORANGE}${ic} image(s)${RESET}"
                fi
                [[ -f "$path/fastfetch/ascii.txt" ]] && echo -e "${WHITE}  ASCII:    ${GREEN}$(wc -l < "$path/fastfetch/ascii.txt") lines${RESET}"
                echo -ne "${WHITE}  Valid:    ${RESET}"
                validate_config "$cf" && echo -e "${GREEN}✓${RESET}" || true
            fi
            echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
            echo -e "\n${GREEN}Press enter to continue...${RESET}"; read -r
        else echo -e "${RED}Invalid selection${RESET}"; sleep 0.5; fi
    else echo -e "${RED}Invalid number${RESET}"; sleep 0.5; fi
