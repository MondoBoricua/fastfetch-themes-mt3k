update_repo() {
    echo ""
    echo -e "${CYAN}━━━ UPDATE THEMES ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    if [[ ! -d "$SCRIPT_DIR/.git" ]]; then
        echo -e "${YELLOW}⚠ Not a git repository. Clone from GitHub to enable updates.${RESET}"
        echo -e "\n${GREEN}Press enter to continue...${RESET}"; read -r; return
    fi
    if ! command -v git &>/dev/null; then
        echo -e "${RED}✗ git is not installed${RESET}"; sleep 1.5; return
    fi
    echo -e "${CYAN}Checking for updates...${RESET}"
    cd "$SCRIPT_DIR"
    git fetch 2>/dev/null
    local branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    local behind=$(git rev-list HEAD..origin/$branch --count 2>/dev/null)
    if [[ "$behind" -gt 0 ]]; then
        echo -e "${GREEN}$behind new commit(s) available!${RESET}"
        git log --oneline HEAD..origin/$branch 2>/dev/null | head -5
        echo -ne "\n${LIME}Pull updates? ${WHITE}[y/N]: ${RESET}"; read -r yn
        if [[ "$yn" =~ ^[yY]$ ]]; then
            git pull
            echo -e "${GREEN}✓ Updated! Rescanning themes...${RESET}"
            scan_themes; sleep 1
        fi
    else
        echo -e "${GREEN}✓ Already up to date!${RESET}"
    fi
    echo -e "\n${GREEN}Press enter to continue...${RESET}"; read -r
}

theme_info() {
    echo -ne "\n${YELLOW}Enter theme number for info: ${RESET}"; read -r choice
    if [[ "$choice" =~ ^[0-9]+$ ]]; then
        local idx=$((10#$choice-1))
        if [[ $idx -ge 0 && $idx -lt ${#F_THEMES[@]} ]]; then
            local ri=${F_IDX[$idx]}
            local name="${THEMES[$ri]}" path="${THEME_PATHS[$ri]}" type="${THEME_TYPES[$ri]}"
