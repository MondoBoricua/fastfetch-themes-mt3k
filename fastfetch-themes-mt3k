slideshow() {
    echo -ne "\n${PINK}Slideshow delay in seconds ${WHITE}[3]: ${RESET}"; read -r delay
    [[ -z "$delay" ]] && delay=3
    [[ -z "$LOGO_PROTOCOL" ]] && LOGO_PROTOCOL="auto"
    echo -e "${PINK}Starting slideshow... Press ${WHITE}Ctrl+C${PINK} to stop${RESET}"; sleep 1
    trap 'echo -e "\n${YELLOW}Slideshow stopped.${RESET}"; trap - INT; return' INT
    for ((i=0; i<${#F_THEMES[@]}; i++)); do
        local ri=${F_IDX[$i]}
        clear
        echo -e "${PINK}━━━ SLIDESHOW ${WHITE}[$((i+1))/${#F_THEMES[@]}] ${PINK}━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
        echo -e "${CYAN}Theme: ${GREEN}${F_THEMES[$i]} ${GRAY}(${F_TYPES[$i]})${RESET}"
        echo -e "${DIM}Press Ctrl+C to stop${RESET}\n"
        apply_theme $ri true 2>/dev/null
        sleep "$delay"
    done
    trap - INT
    echo -e "\n${GREEN}Slideshow complete! Press enter to continue...${RESET}"; read -r
}

