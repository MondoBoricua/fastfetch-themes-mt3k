        echo -e "${GRAY}No favorites yet. Use ${GREEN}[+]${GRAY} to add themes.${RESET}"
        echo -e "\n${GREEN}Press enter to continue...${RESET}"; read -r; return
    fi
    local fav_names=() fav_indices=() fi=1
    while IFS= read -r fn; do
        [[ -z "$fn" ]] && continue
        for ((i=0; i<${#THEMES[@]}; i++)); do
            if [[ "${THEMES[$i]}" == "$fn" ]]; then
                local color=$(get_color "${THEME_TYPES[$i]}")
                echo -e "  ${GREEN}[$fi]${RESET} ${color}${fn} ${GRAY}(${THEME_TYPES[$i]})${RESET}"
                fav_names+=("$fn"); fav_indices+=($i); ((fi++)); break
            fi
        done
    done < "$FAVORITES_FILE"
