prompt_protocol() {
    echo -e "\n${YELLOW}Choose the image rendering protocol for this theme:${RESET}"
    echo -e "${GRAY}───────────────────────────────────────────────────────────────${RESET}"
    echo -e "${GREEN}[1]${RESET} auto          - (Default) Auto-detect."
    echo -e "${GREEN}[2]${RESET} kitty         - Standard Kitty protocol."
    echo -e "${GREEN}[3]${RESET} kitty-direct  - Fastest. WezTerm, Warp, Kitty, Ghostty."
    echo -e "${GREEN}[4]${RESET} iterm         - iTerm2 protocol."
    echo -e "${GREEN}[5]${RESET} sixel         - Sixel graphics support."
    echo -e "${GRAY}───────────────────────────────────────────────────────────────${RESET}"
    while true; do
        echo -ne "${LIME}mt3k${WHITE}@${RED}protocol${RESET}\n${RED}▶${RESET} "
        read -r choice
        case "$choice" in
            1) LOGO_PROTOCOL="auto"; break ;; 2) LOGO_PROTOCOL="kitty"; break ;;
            3) LOGO_PROTOCOL="kitty-direct"; break ;; 4) LOGO_PROTOCOL="iterm"; break ;;
            5) LOGO_PROTOCOL="sixel"; break ;; *) echo -e "${RED}Invalid. Select 1-5.${RESET}" ;;
        esac
    done
}

# ──────────────────────────────────────────────────────────────
# SEARCH / RANDOM / PREVIEW (Enhanced)
# ──────────────────────────────────────────────────────────────

search_themes() {
    echo -ne "\n${YELLOW}Search theme: ${RESET}"; read -r query
    if [[ -z "$query" ]]; then echo -e "${RED}Empty search${RESET}"; sleep 0.5; return; fi
    local found=false
    echo -e "\n${CYAN}Results for '${WHITE}$query${CYAN}':${RESET}"
    echo -e "${GRAY}───────────────────────────────────────────────────────${RESET}"
    for ((i=0; i<${#THEMES[@]}; i++)); do
        local ln=$(echo "${THEMES[$i]}" | tr '[:upper:]' '[:lower:]')
        local lq=$(echo "$query" | tr '[:upper:]' '[:lower:]')
        if [[ "$ln" == *"$lq"* ]]; then
            local color=$(get_color "${THEME_TYPES[$i]}")
            echo -e "  ${GREEN}[$((i+1))]${RESET} ${color}${THEMES[$i]}${RESET} ${GRAY}(${THEME_TYPES[$i]})${RESET}"
            found=true
        fi
    done
    if [[ "$found" == false ]]; then echo -e "  ${RED}No themes found matching '$query'${RESET}"; sleep 1.5; return; fi
    echo -e "${GRAY}───────────────────────────────────────────────────────${RESET}"
    echo -ne "${LIME}mt3k${WHITE}@${YELLOW}search${RESET}\n${RED}▶${RESET} "; read -r choice
    if [[ "$choice" =~ ^[0-9]+$ ]]; then
        local idx=$((10#$choice-1))
        if [[ $idx -ge 0 && $idx -lt ${#THEMES[@]} ]]; then
            [[ "${THEME_TYPES[$idx]}" == "Visuals-Themes" ]] && prompt_protocol
            apply_theme $idx
            echo -e "\n${GREEN}Press enter to continue...${RESET}"; read -r
        else echo -e "${RED}Invalid selection${RESET}"; sleep 0.5; fi
    fi
}

random_theme() {
    echo ""
    echo -e "${PINK}━━━ RANDOM THEME 🎲 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${GREEN}[1]${RESET} Random from ALL"
    echo -e "${RED}[2]${RESET} Random Large"
    echo -e "${LIME}[3]${RESET} Random Small"
    echo -e "${ORANGE}[4]${RESET} Random Visual"
    echo -e "${RED}[x]${RESET} Cancel"
    echo -e "${GRAY}───────────────────────────────────────────────────────${RESET}"
    echo -ne "\n${LIME}mt3k${WHITE}@${PINK}random${RESET}\n${RED}▶${RESET} "; read -r choice
    local pool=() pidx=()
    case "$choice" in
        1) for ((i=0; i<${#THEMES[@]}; i++)); do pool+=("${THEMES[$i]}"); pidx+=($i); done ;;
        2) for ((i=0; i<${#THEMES[@]}; i++)); do [[ "${THEME_TYPES[$i]}" == "Large-Themes" ]] && { pool+=("${THEMES[$i]}"); pidx+=($i); }; done ;;
        3) for ((i=0; i<${#THEMES[@]}; i++)); do [[ "${THEME_TYPES[$i]}" == "Small-Themes" ]] && { pool+=("${THEMES[$i]}"); pidx+=($i); }; done ;;
        4) for ((i=0; i<${#THEMES[@]}; i++)); do [[ "${THEME_TYPES[$i]}" == "Visuals-Themes" ]] && { pool+=("${THEMES[$i]}"); pidx+=($i); }; done ;;
        x|X) return ;; *) echo -e "${RED}Invalid choice${RESET}"; sleep 0.5; return ;;
    esac
    if [[ ${#pool[@]} -eq 0 ]]; then echo -e "${RED}No themes in that category${RESET}"; sleep 1; return; fi
    local ri=$((RANDOM % ${#pool[@]})) real_idx=${pidx[$ri]}
    echo -e "\n${PINK}🎲 Random pick: ${WHITE}${THEMES[$real_idx]} ${GRAY}(${THEME_TYPES[$real_idx]})${RESET}"
    [[ "${THEME_TYPES[$real_idx]}" == "Visuals-Themes" ]] && prompt_protocol
    apply_theme $real_idx
    echo -e "\n${GREEN}Press enter to continue...${RESET}"; read -r
}

preview_theme() {
    echo -ne "\n${CYAN}Enter theme number to preview: ${RESET}"; read -r choice
