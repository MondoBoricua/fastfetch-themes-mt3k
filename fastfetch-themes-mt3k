# ──────────────────────────────────────────────────────────────
# BACKUP / RESTORE (Enhanced)
# ──────────────────────────────────────────────────────────────

backup_config() {
    local backup_dir="$SCRIPT_DIR/Backup-$(date +%Y-%m-%d-%H:%M:%S)"
    mkdir -p "$backup_dir"
    if [[ -d "$CONFIG_DIR" ]]; then
        cp -r "$CONFIG_DIR" "$backup_dir/"
        echo -e "${GREEN}✓ Backup saved to: ${CYAN}$backup_dir${RESET}"
        # Prune old backups
        local backups=($(ls -td "$SCRIPT_DIR"/Backup-* 2>/dev/null))
        if [[ ${#backups[@]} -gt $MAX_BACKUPS ]]; then
            for ((j=$MAX_BACKUPS; j<${#backups[@]}; j++)); do
                rm -rf "${backups[$j]}"
                echo -e "${GRAY}  Pruned: $(basename "${backups[$j]}")${RESET}"
            done
        fi
    else
        echo -e "${YELLOW}⚠ No config to backup${RESET}"
    fi
    sleep 1.5
}

restore_config() {
    local backups=($(ls -td "$SCRIPT_DIR"/Backup-* 2>/dev/null))
    if [[ ${#backups[@]} -eq 0 ]]; then
        echo -e "${RED}✗ No backups found${RESET}"; sleep 1.5; return
    fi
    echo ""
    echo -e "${ORANGE}━━━ AVAILABLE BACKUPS ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    for ((j=0; j<${#backups[@]}; j++)); do
        echo -e "  ${GREEN}[$((j+1))]${RESET} ${WHITE}$(basename "${backups[$j]}")${RESET}"
    done
    echo -e "${RED}  [x]${RESET} Cancel"
    echo -e "${GRAY}───────────────────────────────────────────────────────${RESET}"
    echo -ne "\n${LIME}mt3k${WHITE}@${ORANGE}restore${RESET}\n${RED}▶${RESET} "
    read -r choice
    [[ "$choice" =~ ^[xX]$ ]] && return
    if [[ "$choice" =~ ^[0-9]+$ ]]; then
        local bi=$((10#$choice-1))
        if [[ $bi -ge 0 && $bi -lt ${#backups[@]} ]]; then
            local sel="${backups[$bi]}"
            if [[ -d "$sel/fastfetch" ]]; then
                rm -rf "$CONFIG_DIR"; cp -r "$sel/fastfetch" "$CONFIG_DIR"
                echo -e "${GREEN}✓ Restored from: ${CYAN}$(basename "$sel")${RESET}"
                sleep 1; fastfetch
            else echo -e "${RED}✗ Backup corrupted${RESET}"; sleep 1.5; fi
        else echo -e "${RED}Invalid selection${RESET}"; sleep 0.5; fi
    fi
}

# ──────────────────────────────────────────────────────────────
# THEME APPLICATION (Enhanced)
# ──────────────────────────────────────────────────────────────

apply_theme() {
    local idx=$1 preview_only=${2:-false}
    local theme_path="${THEME_PATHS[$idx]}" theme_name="${THEMES[$idx]}" theme_type="${THEME_TYPES[$idx]}"
    if [[ "$preview_only" == true ]]; then echo -e "${CYAN}Previewing ${GREEN}$theme_name${CYAN}...${RESET}"
    else echo -e "${CYAN}Applying ${GREEN}$theme_name${CYAN}...${RESET}"; fi
    sleep 0.3
    if [[ "$preview_only" == true ]]; then
        local tmp_config=$(mktemp -d)
        cp -r "$theme_path/fastfetch/"* "$tmp_config/"
        local config_file="$tmp_config/config.jsonc"
        if [[ "$theme_type" == "Visuals-Themes" && -f "$config_file" ]]; then
            sedi '/\"logo\": {/,/}/ s/\"type\": \".*\"/\"type\": \"'"$LOGO_PROTOCOL"'\"/' "$config_file"
            sedi "s|\"source\": \"|\"source\": \"$tmp_config/|g" "$config_file"
        fi
        clear
        echo -e "${CYAN}━━━ PREVIEW: ${GREEN}$theme_name ${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
        echo -e "${DIM}(This is a preview only — your config is NOT changed)${RESET}\n"
        fastfetch --config "$config_file" --show-errors 2>/dev/null || fastfetch --config "$tmp_config/config.jsonc" --show-errors
        rm -rf "$tmp_config"
    else
        local src_config="$theme_path/fastfetch/config.jsonc"
        [[ ! -f "$src_config" ]] && src_config="$theme_path/fastfetch/config.json"
        validate_config "$src_config"
        rm -rf "$CONFIG_DIR"; mkdir -p "$CONFIG_DIR"
        cp -r "$theme_path/fastfetch/"* "$CONFIG_DIR/"
        local config_file="$CONFIG_DIR/config.jsonc"
        if [[ "$theme_type" == "Visuals-Themes" && -f "$config_file" ]]; then
            sedi '/\"logo\": {/,/}/ s/\"type\": \".*\"/\"type\": \"'"$LOGO_PROTOCOL"'\"/' "$config_file"
            sedi "s|\"source\": \"|\"source\": \"$CONFIG_DIR/|g" "$config_file"
        fi
        save_current_theme "$theme_name" "$theme_type"
        add_to_history "$theme_name" "$theme_type"
        send_notification "fastfetch-themes-mt3k" "Theme '$theme_name' applied! 🎨"
        clear
        echo -e "${CYAN}Running fastfetch with ${GREEN}$theme_name${CYAN}...${RESET}\n"
        fastfetch --show-errors
    fi
}

