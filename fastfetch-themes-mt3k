            echo -e "${CYAN}━━━ THEME INFO ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
            echo -e "${WHITE}  Name:     ${color}${name}${RESET}"
            echo -e "${WHITE}  Category: ${color}${type}${RESET}"
            echo -e "${WHITE}  Path:     ${GRAY}${path}${RESET}"
            echo -e "${WHITE}  Favorite: ${GREEN}${fav}${RESET}"
            local cf="$path/fastfetch/config.jsonc"
            [[ ! -f "$cf" ]] && cf="$path/fastfetch/config.json"
            if [[ -f "$cf" ]]; then
                local sz=$(du -h "$cf" | cut -f1)
                local mods=$(grep -c '"type"' "$cf" 2>/dev/null || echo "?")
                echo -e "${WHITE}  Config:   ${GRAY}${sz}${RESET}"
                echo -e "${WHITE}  Modules:  ${GRAY}~${mods} detected${RESET}"
                if ls "$path/fastfetch/"*.{png,jpg,jpeg,gif,webp,svg} 2>/dev/null | head -1 &>/dev/null; then
