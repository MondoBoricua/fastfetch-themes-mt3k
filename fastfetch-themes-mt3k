#!/usr/bin/env bash

# fastfetch-themes-mt3k - Auto-detecting fastfetch theme selector
# Detects themes automatically from Large-Themes, Small-Themes, and Visuals-Themes

VERSION="3.0.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$HOME/.config/fastfetch"
DATA_DIR="$HOME/.config/fastfetch-themes-mt3k"
FAVORITES_FILE="$DATA_DIR/favorites.txt"
HISTORY_FILE="$DATA_DIR/history.log"
CURRENT_FILE="$DATA_DIR/current.txt"
MAX_BACKUPS=5

# Colors
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
MAGENTA='\033[1;35m'
ORANGE='\033[38;5;208m'
PINK='\033[38;5;199m'
LIME='\033[38;5;118m'
CYAN='\033[38;5;51m'
WHITE='\033[1;37m'
GRAY='\033[38;5;245m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'

LOGO_PROTOCOL=""
CATEGORY_FILTER=""

IS_MACOS=false
[[ "$(uname)" == "Darwin" ]] && IS_MACOS=true

sedi() {
    if $IS_MACOS; then sed -i '' "$@"; else sed -i "$@"; fi
}

declare -a THEMES THEME_PATHS THEME_TYPES
declare -a F_THEMES F_PATHS F_TYPES F_IDX

# ──────────────────────────────────────────────────────────────
# DATA MANAGEMENT
# ──────────────────────────────────────────────────────────────

init_data_dir() {
    mkdir -p "$DATA_DIR"
    [[ ! -f "$FAVORITES_FILE" ]] && touch "$FAVORITES_FILE"
    [[ ! -f "$HISTORY_FILE" ]] && touch "$HISTORY_FILE"
    [[ ! -f "$CURRENT_FILE" ]] && touch "$CURRENT_FILE"
}

get_current_theme() {
    [[ -f "$CURRENT_FILE" ]] && cat "$CURRENT_FILE" 2>/dev/null || echo ""
}

save_current_theme() { echo "$1|$2" > "$CURRENT_FILE"; }

add_to_history() {
    echo "$(date '+%Y-%m-%d %H:%M:%S')|$1|$2" >> "$HISTORY_FILE"
    local count=$(wc -l < "$HISTORY_FILE" 2>/dev/null)
    if [[ $count -gt 50 ]]; then
        tail -n 50 "$HISTORY_FILE" > "$HISTORY_FILE.tmp" && mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
    fi
}

is_favorite() { grep -qx "$1" "$FAVORITES_FILE" 2>/dev/null; }

toggle_favorite() {
    if is_favorite "$1"; then
        grep -vx "$1" "$FAVORITES_FILE" > "$FAVORITES_FILE.tmp" && mv "$FAVORITES_FILE.tmp" "$FAVORITES_FILE"
        echo -e "${YELLOW}★ Removed '$1' from favorites${RESET}"
    else
        echo "$1" >> "$FAVORITES_FILE"
        echo -e "${GREEN}★ Added '$1' to favorites${RESET}"
    fi
    sleep 0.8
}

validate_config() {
    local cf="$1"
    if command -v jq &>/dev/null && [[ -f "$cf" ]]; then
        if ! sed 's|//.*$||; /\/\*/,/\*\//d' "$cf" 2>/dev/null | jq empty 2>/dev/null; then
            echo -e "${YELLOW}⚠ Config may have JSON issues (non-critical for fastfetch)${RESET}"
            return 1
        fi
    fi
    return 0
}

send_notification() {
    if command -v notify-send &>/dev/null; then
        notify-send "$1" "$2" --icon=terminal 2>/dev/null
    elif $IS_MACOS && command -v osascript &>/dev/null; then
        osascript -e "display notification \"$2\" with title \"$1\"" 2>/dev/null
    fi
}

find_theme_by_name() {
    for ((i=0; i<${#THEMES[@]}; i++)); do
        local ln=$(echo "${THEMES[$i]}" | tr '[:upper:]' '[:lower:]')
        local lq=$(echo "$1" | tr '[:upper:]' '[:lower:]')
        if [[ "$ln" == "$lq" ]]; then echo "$i"; return 0; fi
    done
    return 1
}

# ──────────────────────────────────────────────────────────────
# DEPENDENCY CHECKS
# ──────────────────────────────────────────────────────────────

check_fastfetch() {
    if ! command -v fastfetch &>/dev/null; then
        echo ""
        echo -e "${RED}━━━ fastfetch NOT FOUND ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
        echo -e "${YELLOW}fastfetch is required but not installed.${RESET}"
        echo ""
        local installer=""
        if command -v pacman &>/dev/null; then installer="sudo pacman -S fastfetch"
        elif command -v apt &>/dev/null; then installer="sudo apt install fastfetch"
        elif command -v dnf &>/dev/null; then installer="sudo dnf install fastfetch"
        elif command -v zypper &>/dev/null; then installer="sudo zypper install fastfetch"
        elif command -v brew &>/dev/null; then installer="brew install fastfetch"
        elif command -v nix-env &>/dev/null; then installer="nix-env -iA nixpkgs.fastfetch"
        fi
        if [[ -n "$installer" ]]; then
            echo -e "${GREEN}Detected package manager. Install with:${RESET}"
            echo -e "${CYAN}  $installer${RESET}"
            echo ""
            echo -ne "${LIME}Install now? ${WHITE}[y/N]: ${RESET}"
            read -r yn
            if [[ "$yn" =~ ^[yY]$ ]]; then
                echo -e "${CYAN}Running: $installer${RESET}"
                eval "$installer"
                if command -v fastfetch &>/dev/null; then
                    echo -e "${GREEN}✓ fastfetch installed successfully!${RESET}"; sleep 1; return 0
                else
                    echo -e "${RED}✗ Installation failed. Please install manually.${RESET}"; exit 1
                fi
            else
                echo -e "${YELLOW}Skipped. Please install fastfetch manually.${RESET}"; exit 1
            fi
        else
            echo -e "${RED}Could not detect package manager.${RESET}"
            echo -e "${YELLOW}Install fastfetch manually from:${RESET}"
            echo -e "${CYAN}  https://github.com/fastfetch-cli/fastfetch${RESET}"
            exit 1
        fi
    fi
}

# ──────────────────────────────────────────────────────────────
# NERD FONTS INSTALLER
# ──────────────────────────────────────────────────────────────

install_nerd_fonts() {
    echo ""
    echo -e "${MAGENTA}━━━ NERD FONTS INSTALLER ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${WHITE}Nerd Fonts add icons to your terminal themes.${RESET}"
    echo -e "${GRAY}Fonts will be installed to ${CYAN}~/.local/share/fonts/${RESET}"
    echo ""
    echo -e "${GREEN}[1]${RESET} JetBrainsMono   ${GRAY}- Clean, modern (recommended)${RESET}"
    echo -e "${GREEN}[2]${RESET} Meslo           ${GRAY}- Classic, Powerlevel10k default${RESET}"
    echo -e "${GREEN}[3]${RESET} FiraCode        ${GRAY}- Popular ligature font${RESET}"
    echo -e "${GREEN}[4]${RESET} Hack            ${GRAY}- Minimal and sharp${RESET}"
    echo -e "${GREEN}[5]${RESET} CascadiaCode    ${GRAY}- Microsoft's modern font${RESET}"
    echo -e "${GREEN}[6]${RESET} UbuntuMono      ${GRAY}- Ubuntu's default mono${RESET}"
    echo -e "${GREEN}[7]${RESET} SourceCodePro   ${GRAY}- Adobe's coding font${RESET}"
    echo -e "${GREEN}[a]${RESET} ALL of the above ${GRAY}- Install all 7 fonts${RESET}"
    echo -e "${RED}[x]${RESET} Cancel"
    echo -e "${GRAY}───────────────────────────────────────────────────────${RESET}"
    local fonts=()
    echo -ne "\n${LIME}mt3k${WHITE}@${MAGENTA}fonts${RESET}\n${RED}▶${RESET} "
    read -r choice
    case "$choice" in
        1) fonts=("JetBrainsMono") ;; 2) fonts=("Meslo") ;; 3) fonts=("FiraCode") ;;
        4) fonts=("Hack") ;; 5) fonts=("CascadiaCode") ;; 6) fonts=("UbuntuMono") ;;
        7) fonts=("SourceCodePro") ;;
        a|A) fonts=("JetBrainsMono" "Meslo" "FiraCode" "Hack" "CascadiaCode" "UbuntuMono" "SourceCodePro") ;;
        x|X) return ;; *) echo -e "${RED}Invalid choice${RESET}"; sleep 1; return ;;
    esac
    if ! command -v curl &>/dev/null && ! command -v wget &>/dev/null; then
        echo -e "${RED}Error: curl or wget is required to download fonts.${RESET}"; sleep 2; return
    fi
    if ! command -v unzip &>/dev/null; then
        echo -e "${RED}Error: unzip is required to extract fonts.${RESET}"; sleep 2; return
    fi
    local font_dir="$HOME/.local/share/fonts"
    mkdir -p "$font_dir"
    local tmp_dir=$(mktemp -d)
    local base_url="https://github.com/ryanoasis/nerd-fonts/releases/latest/download"
    local success=0 fail=0
    for font_name in "${fonts[@]}"; do
        local zip_file="$tmp_dir/${font_name}.zip"
        local extract_dir="$font_dir/${font_name}"
        echo -e "${CYAN}⬇ Downloading ${WHITE}${font_name} Nerd Font${CYAN}...${RESET}"
        if command -v curl &>/dev/null; then
            curl -fsSL "$base_url/${font_name}.zip" -o "$zip_file" 2>/dev/null
        else
            wget -q "$base_url/${font_name}.zip" -O "$zip_file" 2>/dev/null
        fi
        if [[ $? -ne 0 ]]; then echo -e "${RED}  ✗ Failed to download ${font_name}${RESET}"; ((fail++)); continue; fi
        mkdir -p "$extract_dir"
        unzip -oqq "$zip_file" -d "$extract_dir" 2>/dev/null
        if [[ $? -ne 0 ]]; then echo -e "${RED}  ✗ Failed to extract ${font_name}${RESET}"; ((fail++)); continue; fi
        find "$extract_dir" -name "*Windows*" -delete 2>/dev/null
        find "$extract_dir" -name "*.md" -delete 2>/dev/null
        find "$extract_dir" -name "LICENSE*" -delete 2>/dev/null
        echo -e "${GREEN}  ✓ ${font_name} installed!${RESET}"; ((success++))
    done
    command -v fc-cache &>/dev/null && { echo -e "${CYAN}Refreshing font cache...${RESET}"; fc-cache -f "$font_dir" 2>/dev/null; }
    rm -rf "$tmp_dir"
    echo ""
    echo -e "${GREEN}━━━ DONE ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${GREEN}  ✓ $success font(s) installed${RESET}"
    [[ $fail -gt 0 ]] && echo -e "${RED}  ✗ $fail font(s) failed${RESET}"
    echo -e "${YELLOW}  ⚠ Remember to set the Nerd Font in your terminal settings!${RESET}"
    echo -e "\n${GREEN}Press enter to continue...${RESET}"; read -r
}

# ──────────────────────────────────────────────────────────────
# KITTY TERMINAL INSTALLER
# ──────────────────────────────────────────────────────────────

install_kitty() {
    echo ""
    echo -e "${ORANGE}━━━ KITTY TERMINAL INSTALLER ━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${WHITE}Kitty is a GPU-accelerated terminal with image support.${RESET}"
    echo -e "${GRAY}Required for Visual themes with kitty/kitty-direct protocol.${RESET}"
    echo ""
    if command -v kitty &>/dev/null; then
        local kitty_ver=$(kitty --version 2>/dev/null | head -1)
        echo -e "${GREEN}✓ Kitty is already installed: ${CYAN}${kitty_ver}${RESET}"
        echo -ne "${YELLOW}Reinstall/update anyway? ${WHITE}[y/N]: ${RESET}"
        read -r yn; [[ ! "$yn" =~ ^[yY]$ ]] && return
    fi
    echo -e "${GREEN}[1]${RESET} Package manager  ${GRAY}- Use your distro's package manager${RESET}"
    echo -e "${GREEN}[2]${RESET} Official script  ${GRAY}- Latest version from kitty.sh (recommended)${RESET}"
    echo -e "${GREEN}[3]${RESET} Flatpak          ${GRAY}- Sandboxed via Flatpak${RESET}"
    echo -e "${RED}[x]${RESET} Cancel"
    echo -e "${GRAY}───────────────────────────────────────────────────────${RESET}"
    echo -ne "\n${LIME}mt3k${WHITE}@${ORANGE}kitty${RESET}\n${RED}▶${RESET} "
    read -r choice
    case "$choice" in
        1)
            local installer=""
            if command -v pacman &>/dev/null; then installer="sudo pacman -S kitty"
            elif command -v apt &>/dev/null; then installer="sudo apt install kitty"
            elif command -v dnf &>/dev/null; then installer="sudo dnf install kitty"
            elif command -v zypper &>/dev/null; then installer="sudo zypper install kitty"
            elif command -v brew &>/dev/null; then installer="brew install --cask kitty"
            elif command -v nix-env &>/dev/null; then installer="nix-env -iA nixpkgs.kitty"
            fi
            if [[ -n "$installer" ]]; then
                echo -e "${CYAN}Running: ${WHITE}$installer${RESET}"; eval "$installer"
                command -v kitty &>/dev/null && echo -e "${GREEN}✓ Kitty installed successfully!${RESET}" || echo -e "${RED}✗ Installation may have failed.${RESET}"
            else echo -e "${RED}✗ Could not detect a supported package manager.${RESET}"; fi ;;
        2)
            echo -e "${CYAN}Downloading Kitty via official installer...${RESET}"
            if command -v curl &>/dev/null; then curl -L https://sw.kovidgoyal.net/kitty/installer.sh | sh /dev/stdin
            elif command -v wget &>/dev/null; then wget -qO- https://sw.kovidgoyal.net/kitty/installer.sh | sh /dev/stdin
            else echo -e "${RED}✗ curl or wget is required.${RESET}"; sleep 2; return; fi
            local kitty_bin="$HOME/.local/kitty.app/bin/kitty"
            if [[ -f "$kitty_bin" ]]; then
                mkdir -p "$HOME/.local/bin"
                ln -sf "$kitty_bin" "$HOME/.local/bin/kitty"
                ln -sf "$HOME/.local/kitty.app/bin/kitten" "$HOME/.local/bin/kitten" 2>/dev/null
                mkdir -p "$HOME/.local/share/applications"
                cp "$HOME/.local/kitty.app/share/applications/kitty.desktop" "$HOME/.local/share/applications/" 2>/dev/null
                sed -i "s|Icon=kitty|Icon=$HOME/.local/kitty.app/share/icons/hicolor/256x256/apps/kitty.png|g" "$HOME/.local/share/applications/kitty.desktop" 2>/dev/null
                echo -e "${GREEN}✓ Kitty installed successfully!${RESET}"
                [[ ":$PATH:" != *":$HOME/.local/bin:"* ]] && echo -e "${YELLOW}⚠ Add ~/.local/bin to PATH${RESET}"
            else echo -e "${RED}✗ Installation may have failed.${RESET}"; fi ;;
        3)
            if ! command -v flatpak &>/dev/null; then echo -e "${RED}✗ Flatpak not installed.${RESET}"; sleep 2; return; fi
            echo -e "${CYAN}Installing Kitty via Flatpak...${RESET}"
            flatpak install -y flathub org.kde.kitty 2>/dev/null || flatpak install -y flathub net.kovidgoyal.kitty 2>/dev/null
            [[ $? -eq 0 ]] && echo -e "${GREEN}✓ Kitty installed!${RESET}" || echo -e "${RED}✗ Failed.${RESET}" ;;
        x|X) return ;; *) echo -e "${RED}Invalid choice${RESET}"; sleep 1; return ;;
    esac
    echo -e "\n${GREEN}Press enter to continue...${RESET}"; read -r
}

# ──────────────────────────────────────────────────────────────
# SHELL AUTO-START SETUP
# ──────────────────────────────────────────────────────────────

setup_shell() {
    echo ""
    echo -e "${BLUE}━━━ SHELL AUTO-START SETUP ━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${WHITE}This adds ${CYAN}fastfetch${WHITE} to run when you open a new terminal.${RESET}"
    echo ""
    local shells_found=() shell_files=() idx=1
    if [[ -f "$HOME/.bashrc" ]]; then
        shells_found+=("bash"); shell_files+=("$HOME/.bashrc")
        echo -e "${GREEN}[$idx]${RESET} Bash   ${GRAY}(~/.bashrc)${RESET}"; ((idx++))
    fi
    if [[ -f "$HOME/.zshrc" ]] || command -v zsh &>/dev/null; then
        shells_found+=("zsh"); shell_files+=("$HOME/.zshrc")
        echo -e "${GREEN}[$idx]${RESET} Zsh    ${GRAY}(~/.zshrc)${RESET}"; ((idx++))
    fi
    if command -v fish &>/dev/null; then
        shells_found+=("fish"); shell_files+=("$HOME/.config/fish/config.fish")
        echo -e "${GREEN}[$idx]${RESET} Fish   ${GRAY}(~/.config/fish/config.fish)${RESET}"; ((idx++))
    fi
    if [[ ${#shells_found[@]} -eq 0 ]]; then
        echo -e "${RED}No supported shells detected${RESET}"; sleep 2; return
    fi
    echo -e "${RED}[x]${RESET} Cancel"
    echo -e "${GRAY}───────────────────────────────────────────────────────${RESET}"
    echo -ne "\n${LIME}mt3k${WHITE}@${BLUE}shell${RESET}\n${RED}▶${RESET} "
    read -r choice
    [[ "$choice" =~ ^[xX]$ ]] && return
    if ! [[ "$choice" =~ ^[0-9]+$ ]] || [[ $choice -lt 1 ]] || [[ $choice -gt ${#shells_found[@]} ]]; then
        echo -e "${RED}Invalid choice${RESET}"; sleep 1; return
    fi
    local si=$((choice-1)) shell_name="${shells_found[$si]}" rc_file="${shell_files[$si]}"
    local marker="# fastfetch-themes-mt3k auto-start"
    if [[ -f "$rc_file" ]] && grep -q "$marker" "$rc_file" 2>/dev/null; then
        echo -ne "\n${YELLOW}⚠ Already configured. Remove it? ${WHITE}[y/N]: ${RESET}"
        read -r yn
        if [[ "$yn" =~ ^[yY]$ ]]; then
            if [[ "$shell_name" == "fish" ]]; then sedi "/$marker/,/^end$/d" "$rc_file"
            else sedi "/$marker/,/^fi$/d" "$rc_file"; fi
            echo -e "${GREEN}✓ Removed fastfetch auto-start${RESET}"
        fi
        sleep 1.5; return
    fi
    [[ ! -f "$rc_file" ]] && { mkdir -p "$(dirname "$rc_file")"; touch "$rc_file"; }
    echo "" >> "$rc_file"
    if [[ "$shell_name" == "fish" ]]; then
        cat >> "$rc_file" << 'FISH_EOF'
# fastfetch-themes-mt3k auto-start
if status is-interactive
    if type -q fastfetch
        fastfetch
    end
end
FISH_EOF
    else
        cat >> "$rc_file" << 'BASH_EOF'
# fastfetch-themes-mt3k auto-start
if command -v fastfetch &>/dev/null; then
    fastfetch
fi
BASH_EOF
    fi
    echo -e "\n${GREEN}✓ fastfetch will run when you open ${CYAN}${shell_name}${GREEN}!${RESET}"
    echo -e "${DIM}  (Run this option again to remove it)${RESET}"
    sleep 2
}

# ──────────────────────────────────────────────────────────────
# THEME SCANNING
# ──────────────────────────────────────────────────────────────

scan_themes() {
    THEMES=(); THEME_PATHS=(); THEME_TYPES=()
    for category in "Large-Themes" "Small-Themes" "Visuals-Themes"; do
        local dir="$SCRIPT_DIR/$category"
        [[ ! -d "$dir" ]] && continue
        for theme_dir in "$dir"/*/; do
            [[ ! -d "$theme_dir" ]] && continue
            local theme_name=$(basename "$theme_dir")
            [[ "$theme_name" == "Default" ]] && continue
            if [[ -f "$theme_dir/fastfetch/config.jsonc" ]] || [[ -f "$theme_dir/fastfetch/config.json" ]]; then
                THEMES+=("$theme_name"); THEME_PATHS+=("$theme_dir"); THEME_TYPES+=("$category")
            fi
        done
    done
    apply_filter
}

apply_filter() {
    F_THEMES=(); F_PATHS=(); F_TYPES=(); F_IDX=()
    for ((i=0; i<${#THEMES[@]}; i++)); do
        if [[ -z "$CATEGORY_FILTER" ]] || [[ "${THEME_TYPES[$i]}" == "$CATEGORY_FILTER" ]]; then
            F_THEMES+=("${THEMES[$i]}"); F_PATHS+=("${THEME_PATHS[$i]}")
            F_TYPES+=("${THEME_TYPES[$i]}"); F_IDX+=($i)
        fi
    done
}

# ──────────────────────────────────────────────────────────────
# UI COMPONENTS
# ──────────────────────────────────────────────────────────────

get_color() {
    case "$1" in
        "Large-Themes") echo -e "$RED" ;; "Small-Themes") echo -e "$LIME" ;;
        "Visuals-Themes") echo -e "$ORANGE" ;; *) echo -e "$GREEN" ;;
    esac
}

banner() {
    clear
    echo -e "${RED}  __           _    __     _       _       ${RESET}"
    echo -e "${ORANGE} / _| __ _ ___| |_ / _| __|_|_ ___| |__    ${RESET}"
    echo -e "${LIME}| |_ / _\` / __| __| |_ / _ \\ __/ __| '_ \\   ${RESET}"
    echo -e "${GREEN}|  _| (_| \\__ \\ |_|  _|  __/ || (__| | | |  ${RESET}"
    echo -e "${CYAN}|_|  \\__,_|___/\\__|_|  \\___|\\__\\___|_| |_|  ${RESET}"
    echo -e "${WHITE}        themes-mt3k ${GRAY}v${VERSION}${RESET}"
    echo ""
    local current=$(get_current_theme)
    if [[ -n "$current" ]]; then
        local cur_name=$(echo "$current" | cut -d'|' -f1)
        local cur_type=$(echo "$current" | cut -d'|' -f2)
        local cur_color=$(get_color "$cur_type")
        echo -e "${WHITE}  🎨 Current: ${cur_color}${cur_name} ${GRAY}(${cur_type})${RESET}"
    fi
    local large=0 small=0 visual=0
    for t in "${THEME_TYPES[@]}"; do
        case "$t" in "Large-Themes") ((large++)) ;; "Small-Themes") ((small++)) ;; "Visuals-Themes") ((visual++)) ;; esac
    done
    echo -e "${RED}[L]${GRAY}=${RED}Large($large)  ${LIME}[S]${GRAY}=${LIME}Small($small)  ${ORANGE}[V]${GRAY}=${ORANGE}Visual($visual)  ${WHITE}Total: ${#THEMES[@]}${RESET}"
    if [[ -n "$CATEGORY_FILTER" ]]; then
        local fcolor=$(get_color "$CATEGORY_FILTER")
        echo -e "${YELLOW}  ⚡ Filter: ${fcolor}${CATEGORY_FILTER}${YELLOW} (${#F_THEMES[@]} shown)${RESET}"
    fi
    echo -e "${GRAY}────────────────────────────────────────────${RESET}"
}

display_themes() {
    local cols=4 col_width=18 current_cat="" col=0
    for ((i=0; i<${#F_THEMES[@]}; i++)); do
        local cat="${F_TYPES[$i]}" color=$(get_color "${F_TYPES[$i]}") num=$((i+1))
        local fav=""; is_favorite "${F_THEMES[$i]}" && fav="★"
        if [[ "$cat" != "$current_cat" ]]; then
            [[ $col -ne 0 ]] && echo ""; col=0; current_cat="$cat"; echo ""
            case "$cat" in
                "Large-Themes")   echo -e "${RED}━━━ LARGE ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}" ;;
                "Small-Themes")   echo -e "${LIME}━━━ SMALL ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}" ;;
                "Visuals-Themes") echo -e "${ORANGE}━━━ VISUAL ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}" ;;
            esac
        fi
        local dn="${F_THEMES[$i]:0:$((col_width-2))}${fav}"
        printf "${GREEN}[%02d]${RESET}${color}%-${col_width}s${RESET}" "$num" "$dn"
        ((col++))
        (( col >= cols )) && { echo ""; col=0; }
    done
    [[ $col -ne 0 ]] && echo ""
    echo ""
    echo -e "${GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
