        banner
        display_themes
        echo -ne "\n${LIME}mt3k${WHITE}@${RED}themes${RESET}\n${RED}▶${RESET} "
        read -r choice
        case "$choice" in
            x|X|q|Q) clear; echo -e "${RED}Goodbye!${RESET}"; exit 0 ;;
            b|B) backup_config ;; r|R) restore_config ;;
            f|F) install_nerd_fonts ;; s|S) setup_shell ;;
            d|D) random_theme ;; p|P) preview_theme ;;
            k|K) install_kitty ;; /|\\) search_themes ;;
            u|U) update_repo ;; v|V) favorites_menu ;;
            h|H) show_history ;; c|C) filter_menu ;;
            w|W) slideshow ;; i|I) theme_info ;;
            +) add_favorite_prompt ;;
            ''|*[!0-9]*) echo -e "${RED}Invalid selection${RESET}"; sleep 0.5 ;;
            *)
                local idx=$((10#$choice-1))
                if [[ $idx -ge 0 && $idx -lt ${#F_THEMES[@]} ]]; then
                    local real_idx=${F_IDX[$idx]}
                    [[ "${THEME_TYPES[$real_idx]}" == "Visuals-Themes" ]] && prompt_protocol
                    apply_theme $real_idx
                    echo -e "\n${GREEN}Press enter to continue...${RESET}"; read -r
                else echo -e "${RED}Invalid selection${RESET}"; sleep 0.5; fi
                ;;
        esac
    done
}

# CLI argument parsing
if [[ $# -gt 0 ]]; then
    case "$1" in
        --help|-h) show_help; exit 0 ;;
        --version|-V) echo "fastfetch-themes-mt3k v$VERSION"; exit 0 ;;
        --list|-l)
            scan_themes
            if [[ -n "$2" ]]; then
                case "$2" in large|L) CATEGORY_FILTER="Large-Themes" ;; small|S) CATEGORY_FILTER="Small-Themes" ;; visual|V) CATEGORY_FILTER="Visuals-Themes" ;; esac
                apply_filter
            fi
            for ((i=0; i<${#F_THEMES[@]}; i++)); do echo "${F_THEMES[$i]} (${F_TYPES[$i]})"; done; exit 0 ;;
        --apply|-a)
            check_fastfetch; init_data_dir; scan_themes
            idx=$(find_theme_by_name "$2")
            if [[ -n "$idx" ]]; then
                [[ "${THEME_TYPES[$idx]}" == "Visuals-Themes" ]] && LOGO_PROTOCOL="${3:-auto}"
                apply_theme $idx; exit 0
            else echo "Theme '$2' not found"; exit 1; fi ;;
        --preview)
            check_fastfetch; init_data_dir; scan_themes
            idx=$(find_theme_by_name "$2")
            if [[ -n "$idx" ]]; then
                [[ "${THEME_TYPES[$idx]}" == "Visuals-Themes" ]] && LOGO_PROTOCOL="${3:-auto}"
                apply_theme $idx true; exit 0
            else echo "Theme '$2' not found"; exit 1; fi ;;
        --random)
            check_fastfetch; init_data_dir; scan_themes
            if [[ -n "$2" ]]; then
                case "$2" in large|L) CATEGORY_FILTER="Large-Themes" ;; small|S) CATEGORY_FILTER="Small-Themes" ;; visual|V) CATEGORY_FILTER="Visuals-Themes" ;; esac
                apply_filter
            fi
            ri=$((RANDOM % ${#F_THEMES[@]})); real_idx=${F_IDX[$ri]}
            [[ "${THEME_TYPES[$real_idx]}" == "Visuals-Themes" ]] && LOGO_PROTOCOL="auto"
            echo -e "${PINK}🎲 ${THEMES[$real_idx]} (${THEME_TYPES[$real_idx]})${RESET}"
            apply_theme $real_idx; exit 0 ;;
        --search)
            scan_themes
            for ((i=0; i<${#THEMES[@]}; i++)); do
                ln=$(echo "${THEMES[$i]}" | tr '[:upper:]' '[:lower:]')
                lq=$(echo "$2" | tr '[:upper:]' '[:lower:]')
                [[ "$ln" == *"$lq"* ]] && echo "${THEMES[$i]} (${THEME_TYPES[$i]})"
            done; exit 0 ;;
        --update) update_repo; exit 0 ;;
        --favorites) init_data_dir; [[ -s "$FAVORITES_FILE" ]] && cat "$FAVORITES_FILE" || echo "No favorites"; exit 0 ;;
        --history)
            init_data_dir
            if [[ -s "$HISTORY_FILE" ]]; then
                tail -n 10 "$HISTORY_FILE" | while IFS='|' read -r ts n t; do echo "[$ts] $n ($t)"; done
            else echo "No history"; fi; exit 0 ;;
        *) echo "Unknown option: $1. Use --help"; exit 1 ;;
    esac
fi

main "$@"
