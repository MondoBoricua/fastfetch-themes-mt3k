{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii.txt",
         "color": {
        "1": "1"
    }
    },
    "modules": [
        {
            "type": "os",
            "key": " ",
            "keyColor": "1",
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "1",
        },
        {
            "type": "packages",
            "key": " ",
            "keyColor": "1",  
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "1", 
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "1", 
        },
                        {
            "type": "de",
            "key": " ",
            "keyColor": "1"
        },
                {
            "type": "gpu",
            "key": "󰍛 ",
            "format": "{3}",
            "keyColor": "1"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "1", 
        },
                        {
            "type": "wmtheme",
            "key": "󰉼 ",
            "keyColor": "1"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "1", 
        },
        {
            "type": "terminalfont",
            "key": " ",
            "keyColor": "1", 
        },
    ]
}

